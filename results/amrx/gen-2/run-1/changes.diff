diff -ruN original/build.sh final/build.sh
--- original/build.sh	1969-12-31 19:00:00
+++ final/build.sh	2026-11-16 14:30:33
@@ -0,0 +1,4 @@
+#!/bin/bash
+# Builds ./amr. Change this as you like; the grader runs it as `bash build.sh`.
+set -e
+${CC:-gcc} -O3 -fopenmp -march=x86-64-v3 -mtune=native -flto -std=gnu99 -DPRKVERSION='"2.17"' -DDOUBLE=1 -DRADIUS=2 -DSTAR=1 -DLOOPGEN=0 -DVERBOSE=0 -DRESTRICT_KEYWORD=1 -I. amr.c wtime.c -lm -o amr
