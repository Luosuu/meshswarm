 /// \param [out] df The interpolated value of df(r)/dr.
+
+/// Interpolate two tables that share the same r grid (phi and rho),
+/// computing the grid index math once.
+static void interpolate2(InterpolationObject* ta, InterpolationObject* tb,
+                         real_t r, real_t* fa, real_t* dfa, real_t* fb, real_t* dfb)
+{
+   const real_t* tta = ta->values; // same grid: n, x0, invDx identical
+   const real_t* ttb = tb->values;
+
+   if ( r < ta->x0 ) r = ta->x0;
+
+   r = (r-ta->x0)*(ta->invDx) ;
+   int ii = (int)floor(r);
+   if (ii > ta->n)
+   {
+      ii = ta->n;
+      r = ta->n / ta->invDx;
+   }
+   // reset r to fractional distance
+   r = r - floor(r);
+
+   real_t g1a = tta[ii+1] - tta[ii-1];
+   real_t g2a = tta[ii+2] - tta[ii];
+   *fa = tta[ii] + 0.5*r*(g1a + r*(tta[ii+1] + tta[ii-1] - 2.0*tta[ii]) );
+   *dfa = 0.5*(g1a + r*(g2a-g1a))*ta->invDx;
+
+   real_t g1b = ttb[ii+1] - ttb[ii-1];
+   real_t g2b = ttb[ii+2] - ttb[ii];
+   *fb = ttb[ii] + 0.5*r*(g1b + r*(ttb[ii+1] + ttb[ii-1] - 2.0*ttb[ii]) );
+   *dfb = 0.5*(g1b + r*(g2b-g1b))*tb->invDx;
+}
