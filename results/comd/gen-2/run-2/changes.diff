 #define _MEMUTILS_H_
 
 #include <stdlib.h>
+#include <malloc.h>
+#include <string.h>
 
 #define freeMe(s,element) {if(s->element) comdFree(s->element);  s->element = NULL;}
 
+// All CoMD allocations go through comdMalloc/comdCalloc/comdFree; keep them
+// in one header so alignment and the matching release call stay paired.
+// We use an aligned (64B) allocator for the large atom/link-cell arrays;
+// comdFree matches it with free(), which is valid for memalign'd memory in
+// glibc (memalign returns memory that free() can release).
 static void* comdMalloc(size_t iSize)
 {
-   return malloc(iSize);
+   // Round up small requests to 16 bytes so malloc/free are happy either way.
+   void* ptr = memalign(64, iSize);
+   return ptr;
 }
 
 static void* comdCalloc(size_t num, size_t iSize)
 {
-   return calloc(num, iSize);
+   size_t total = num * iSize;
+   if (total == 0) return NULL;
+   void* ptr = memalign(64, total);
+   if (!ptr) return NULL;
+   memset(ptr, 0, total); // memalign does not zero; keep calloc semantics
+   return ptr;
 }
 
 static void* comdRealloc(void* ptr, size_t iSize)
 {
-   return realloc(ptr, iSize);
+   void* n = realloc(ptr, iSize);
+   return n;
 }
 
