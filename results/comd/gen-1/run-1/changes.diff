+
+/// Fast path for table interpolation: assumes 0 <= r <= cutoff and table covers range.
+/// Computes both f(r) and f'(r) with the same formulas as interpolate().
+static inline void interpolateFast(InterpolationObject* table, real_t r, real_t* f, real_t* df)
+{
+   const real_t* tt = table->values; // tt[-1]..tt[n+1] valid due to guard cells
+   real_t x = (r - table->x0) * table->invDx;
+   int ii = (int)floor(x);
+   if (ii < 0) ii = 0;         // guard: r very close to 0
+   else if (ii > table->n) ii = table->n;
+   real_t fr = x - (real_t)ii;
+   if (fr < 0.0) fr = 0.0;
+   else if (fr >= 1.0) fr = 1.0; // only when clamped at top
+
+   real_t g1 = tt[ii+1] - tt[ii-1];
+   real_t g2 = tt[ii+2] - tt[ii];
+
+   *f = tt[ii] + 0.5*fr*(g1 + fr*(tt[ii+1] + tt[ii-1] - 2.0*tt[ii]) );
+
+   *df = 0.5*(g1 + fr*(g2-g1))*table->invDx;
 }
 
