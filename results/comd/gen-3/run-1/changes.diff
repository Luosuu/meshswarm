+static inline real_t interpolateValue(InterpolationObject* table, real_t r)
+{
+   const real_t* tt = table->values;
+
+   if ( r < table->x0 ) r = table->x0;
+
+   r = (r-table->x0)*(table->invDx) ;
+   int ii = (int)floor(r);
+   if (ii > table->n)
