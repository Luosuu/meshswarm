+# Physical constants (from BlanketValveDAE.mo)
+TAU_HYD = 0.02
+K_FWD = 0.24
+K_REV = 14.0
+K_BYP = 0.08
+C_BLANKET = 26.0
+C_HX = 11.0
+CP_COOL = 1.85
+H_SINK = 0.90
+T_SINK = 570.0
+P_BASE = 115.0
+K_PERM = 0.042
+ALPHA_NL = 0.65
