 /* might want to add access methods so that memory can be */
 /* better managed, as in luleshFT */
 
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+// Grow-only, size-class cache behind Allocate/Release.
+// Freed blocks are cached (up to a hard byte cap) so repeated
+// per-timestep alloc/release churn is served from cache.
+// A 16-byte header before each block records its padded size class.
+#define LULESH_ALLOC_CACHE_MAX_BYTES (512ull*1024*1024)
+#define LULESH_ALLOC_CACHE_MAX_BLOCKS_PER_CLASS 4096
+#define LULESH_ALLOC_HEADER 16
+
+struct AllocCache {
+   std::mutex mtx ;
+   std::unordered_map<size_t, std::vector<void*> > freeLists ;
+   size_t cachedBytes = 0 ;
+} ;
+
+inline AllocCache & AllocCacheGet()
+{
+   static AllocCache c ;
+   return c ;
+}
+
 template <typename T>
 T *Allocate(size_t size)
 {
-   return static_cast<T *>(malloc(sizeof(T)*size)) ;
+   size_t bytes = sizeof(T)*size ;
+   if (bytes == 0) bytes = 1 ;
+   size_t classed = (bytes + 15) & ~size_t(15) ;
+   AllocCache &c = AllocCacheGet() ;
+   {
+      std::lock_guard<std::mutex> lock(c.mtx) ;
+      std::unordered_map<size_t, std::vector<void*> >::iterator it = c.freeLists.find(classed) ;
+      if (it != c.freeLists.end() && !it->second.empty()) {
+         void *raw = it->second.back() ;
+         it->second.pop_back() ;
+         c.cachedBytes -= classed ;
+         return reinterpret_cast<T *>(static_cast<char*>(raw) + LULESH_ALLOC_HEADER) ;
+      }
+   }
+   void *raw = malloc(classed + LULESH_ALLOC_HEADER) ;
+   if (raw == NULL) return NULL ;
+   *reinterpret_cast<size_t*>(raw) = classed ;
+   return reinterpret_cast<T *>(static_cast<char*>(raw) + LULESH_ALLOC_HEADER) ;
 }
 
 template <typename T>
 void Release(T **ptr)
 {
-   if (*ptr != NULL) {
-      free(*ptr) ;
-      *ptr = NULL ;
+   if (*ptr == NULL) return ;
+   void *raw = static_cast<void*>(static_cast<char*>(static_cast<void*>(*ptr)) - LULESH_ALLOC_HEADER) ;
+   size_t classed = *reinterpret_cast<size_t*>(raw) ;
+   AllocCache &c = AllocCacheGet() ;
+   bool cached = false ;
+   {
+      std::lock_guard<std::mutex> lock(c.mtx) ;
+      if (c.cachedBytes + classed <= LULESH_ALLOC_CACHE_MAX_BYTES) {
+         std::vector<void*> &fl = c.freeLists[classed] ;
+         if (fl.size() < LULESH_ALLOC_CACHE_MAX_BLOCKS_PER_CLASS) {
+            fl.push_back(raw) ;
+            c.cachedBytes += classed ;
+            cached = true ;
+         }
+      }
    }
+   if (!cached) free(raw) ;
+   *ptr = NULL ;
 }
 
