+// Caching allocator: reuse freed blocks of the same size class instead of
+// hitting malloc/free every timestep.  Keeps a hard cap on cached bytes.
+#include <unordered_map>
+#include <vector>
+#include <mutex>
+
+#define ALLOC_CACHE_MAX_BYTES (512ull * 1024 * 1024)
+
+class AllocCache {
+public:
+   static AllocCache &instance() {
+      static AllocCache cache ;
+      return cache ;
+   }
+
+   void *get(size_t bytes) {
+      if (bytes == 0) bytes = 1 ;
+      std::lock_guard<std::mutex> lock(m_mutex) ;
+      auto it = m_free.find(bytes) ;
+      if (it != m_free.end() && !it->second.empty()) {
+         void *p = it->second.back() ;
+         it->second.pop_back() ;
+         m_cachedBytes -= bytes ;
+         m_live[p] = bytes ;
+         return p ;
+      }
+      void *p = malloc(bytes) ;
+      if (p) m_live[p] = bytes ;
+      return p ;
+   }
+
+   void put(void *p) {
+      if (!p) return ;
+      std::lock_guard<std::mutex> lock(m_mutex) ;
+      auto it = m_live.find(p) ;
+      if (it == m_live.end()) { free(p) ; return ; }  // not ours (safety)
+      size_t bytes = it->second ;
+      m_live.erase(it) ;
+      if (m_cachedBytes + bytes > ALLOC_CACHE_MAX_BYTES) {
+         free(p) ;
+         return ;
+      }
+      m_free[bytes].push_back(p) ;
+      m_cachedBytes += bytes ;
+   }
+
+private:
+   AllocCache() : m_cachedBytes(0) {}
+   ~AllocCache() {
+      for (auto &kv : m_free)
+         for (void *p : kv.second) free(p) ;
+   }
+   AllocCache(const AllocCache &) = delete ;
+   AllocCache &operator=(const AllocCache &) = delete ;
+
