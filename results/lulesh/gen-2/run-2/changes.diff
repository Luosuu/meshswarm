+// Per-step temporary allocation cache.
+// LULESH allocates and releases many large temporaries every time step;
+// caching the underlying buffers removes malloc/free and page-fault churn.
+// Each cached block carries a 16-byte header with its total size so
+// Release can return it to the right size class. All allocation call
+// sites are outside parallel regions, so no locking is needed.
+class AllocCache {
+public:
+   static const size_t MAX_BYTES = 1024ull*1024*1024; // hard cap on cached bytes
+   static const size_t HDR = 16;
+   static void *get(size_t bytes) {
+      std::map<size_t, std::vector<void*> > &c = cache();
+      std::map<size_t, std::vector<void*> >::iterator it = c.find(bytes);
+      if (it != c.end() && !it->second.empty()) {
+         void *p = it->second.back();
+         it->second.pop_back();
+         cachedBytes() -= bytes + HDR;
+         return (char*)p + HDR;
+      }
+      void *raw = malloc(bytes + HDR);
+      if (!raw) return NULL;
+      *(size_t*)raw = bytes;
+      return (char*)raw + HDR;
+   }
+   static void put(void *p) {
+      if (!p) return;
+      char *raw = (char*)p - HDR;
+      size_t bytes = *(size_t*)raw;
+      if (cachedBytes() + bytes + HDR > MAX_BYTES) { free(raw); return; }
+      cache()[bytes].push_back(raw);
+      cachedBytes() += bytes + HDR;
+   }
+private:
+   static std::map<size_t, std::vector<void*> > &cache() { static std::map<size_t, std::vector<void*> > c; return c; }
+   static size_t &cachedBytes() { static size_t b = 0; return b; }
+};
 
 template <typename T>
 T *Allocate(size_t size)
 {
-   return static_cast<T *>(malloc(sizeof(T)*size)) ;
+   return static_cast<T *>(AllocCache::get(sizeof(T)*size)) ;
 }
 
 template <typename T>
