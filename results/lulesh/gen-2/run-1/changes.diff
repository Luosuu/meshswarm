+   AllocPool<T> &pool = MyAllocPool<T>() ;
+   int c = AllocPool<T>::classFor(size) ;
+   if (c >= 0) {
+      std::lock_guard<std::mutex> lock(pool.mtx) ;
+      for (int k = c ; k <= AllocPool<T>::MAX_CLASS ; ++k) {
+         if (!pool.bucket[k].empty()) {
+            T *raw = pool.bucket[k].back() ;
+            pool.bucket[k].pop_back() ;
