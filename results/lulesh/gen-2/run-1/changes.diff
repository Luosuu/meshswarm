+// Size-class caching allocator for temporary buffers. LULESH allocates and
+// frees the same large temporaries every time step; routing them through a
+// bounded free-list pool avoids the malloc/free churn (and page faults)
+// without changing what is computed. A 16-byte header records the class so
+// Release can return the block to the pool. Blocks beyond the cap are really
+// freed.
+template <typename T>
+struct AllocPool {
+   static const int MIN_CLASS = 3 ;        // 8 elements
+   static const int MAX_CLASS = 24 ;       // 16M elements (128 MB of Real_t)
+   static const size_t CAP_BYTES = size_t(768) << 20 ;  // total cached cap
+   static const size_t HEADER = 16 ;
+   std::vector<T*> bucket[MAX_CLASS + 1] ;
+   size_t cachedBytes = 0 ;
+   std::mutex mtx ;
+
+   static int classFor(size_t n) {
+      int c = MIN_CLASS ;
+      size_t s = size_t(1) << c ;
+      while (s < n) {
+         if (c >= MAX_CLASS) return -1 ;
+         ++c ; s <<= 1 ;
+      }
+      return c ;
+   }
+   static size_t blockBytes(int c) { return (size_t(1) << c) * sizeof(T) ; }
+} ;
+
+template <typename T>
+AllocPool<T> &MyAllocPool()
+{
+   static AllocPool<T> p ;
+   return p ;
+}
 
