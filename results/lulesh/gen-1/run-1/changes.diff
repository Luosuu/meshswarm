+// instead of malloc/free each iteration. A size header is stored just
+// before the returned pointer so Release can return it to the right bucket.
+// Size-cached scratch allocator for small temporaries reused each step.
+// Large buffers are not cached (they bloat working set and page traffic).
+namespace alloc_cache {
+   const size_t MAX_BYTES = 512*1024*1024 ;
+   const size_t MAX_TOTAL = 1024*1024*1024 ;
+   const size_t MAX_PER_BUCKET = 2 ;
+   inline std::map<size_t, std::vector<void *> > &cache() { static std::map<size_t, std::vector<void *> > c ; return c ; }
+   inline size_t &total() { static size_t t = 0 ; return t ; }
+}
+
 template <typename T>
 T *Allocate(size_t size)
 {
-   return static_cast<T *>(malloc(sizeof(T)*size)) ;
+   size_t bytes = sizeof(T)*size ;
+   if (bytes <= alloc_cache::MAX_BYTES) {
+      auto &cache = alloc_cache::cache() ;
+      auto it = cache.find(bytes) ;
+      if (it != cache.end() && !it->second.empty()) {
+         size_t *raw = static_cast<size_t *>(it->second.back()) ;
+         it->second.pop_back() ;
+         alloc_cache::total() -= bytes ;
+         return reinterpret_cast<T *>(raw + 2) ;
+      }
+   }
+   // header holds the byte size so Release can bucket it
+   size_t *raw = static_cast<size_t *>(malloc(bytes + 2*sizeof(size_t))) ;
+   raw[0] = bytes ;
+   return reinterpret_cast<T *>(raw + 2) ;
 }
 
 template <typename T>
 void Release(T **ptr)
 {
    if (*ptr != NULL) {
-      free(*ptr) ;
+      size_t *raw = reinterpret_cast<size_t *>(*ptr) - 2 ;
+      size_t bytes = raw[0] ;
+      // cache only small buffers and keep the total bounded
+      auto &bucket = alloc_cache::cache()[bytes] ;
+      if (bytes <= alloc_cache::MAX_BYTES && bucket.size() < alloc_cache::MAX_PER_BUCKET && alloc_cache::total() + bytes <= alloc_cache::MAX_TOTAL) {
+         bucket.push_back(raw) ;
+         alloc_cache::total() += bytes ;
+      } else {
+         free(raw) ;
+      }
       *ptr = NULL ;
    }
 }
