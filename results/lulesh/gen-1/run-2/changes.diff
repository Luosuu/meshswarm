+/* Simple reusable scratch allocator: caches freed blocks by size to avoid
+ * repeated large malloc/free per timestep. Falls back to malloc for new sizes. */
+struct ScratchCache {
+   static const size_t kMaxCached = 1u << 31 ;  /* 2 GB cap */
+   static const size_t kHeader = 16 ;
+   struct Node { Node* next ; size_t size ; } ;
+   Node* lists[65] ;
+   size_t cachedBytes ;
+   ScratchCache() : cachedBytes(0) { for (int i = 0; i < 65; i++) lists[i] = NULL ; }
+   static int sizeClass(size_t bytes) {
+      int c = 0 ;
+      size_t b = bytes ;
+      while (b > 1) { b >>= 1 ; c++ ; }
+      return c + 1 ; /* 1..64 */
+   }
+} ;
+inline ScratchCache& ScratchCacheInstance() {
+   static ScratchCache cache ;
+   return cache ;
+}
+inline void* ScratchAlloc(size_t bytes) {
+   ScratchCache& cache = ScratchCacheInstance() ;
+   int cls = ScratchCache::sizeClass(bytes) ;
+   ScratchCache::Node* n = cache.lists[cls] ;
+   while (n) {
+      if (n->size >= bytes) {
+         /* pop */
+         cache.lists[cls] = n->next ;
+         cache.cachedBytes -= n->size ;
+         void* p = reinterpret_cast<char*>(n) + ScratchCache::kHeader ;
+         /* store actual requested size for perfect reuse bookkeeping */
+         reinterpret_cast<size_t*>(p)[-1] = bytes ;
+         return p ;
+      }
+      n = n->next ;
+   }
+   char* raw = static_cast<char*>(malloc(bytes + ScratchCache::kHeader)) ;
+   if (!raw) return NULL ;
+   reinterpret_cast<size_t*>(raw + 0)[0] = bytes ;
+   reinterpret_cast<size_t*>(raw + 8)[0] = 0 ;
+   return raw + ScratchCache::kHeader ;
+}
+inline void ScratchRelease(void* ptr) {
+   ScratchCache& cache = ScratchCacheInstance() ;
+   char* raw = static_cast<char*>(ptr) - ScratchCache::kHeader ;
+   size_t bytes = reinterpret_cast<size_t*>(raw)[0] ;
+   if (cache.cachedBytes + bytes <= ScratchCache::kMaxCached) {
+      int cls = ScratchCache::sizeClass(bytes) ;
+      ScratchCache::Node* n = reinterpret_cast<ScratchCache::Node*>(raw) ;
+      n->size = bytes ;
+      n->next = cache.lists[cls] ;
+      cache.lists[cls] = n ;
+      cache.cachedBytes += bytes ;
+   } else {
+      free(raw) ;
+   }
+}
